{
  "name": "tower-defence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "server": "tsx watch server/main.ts",
    "server:probe": "tsx server/probe.ts",
    "level-icons": "tsx tools/levelIcons.ts",
    "build:server": "vite build --ssr server/main.ts --outDir dist-server",
    "start": "node dist-server/main.js --static dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.0.3",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "ws": "8.22.0"
  }
}
